[
  {
    "name": "empresa",
    "purpose": "Identifica cada microempresa y su umbral operativo de liquidez.",
    "fields": [
      {
        "name": "id",
        "type": "BIGINT",
        "key": "PK",
        "desc": "Identificador interno"
      },
      {
        "name": "nit",
        "type": "VARCHAR(30)",
        "key": "UQ",
        "desc": "NIT normalizado sin separadores"
      },
      {
        "name": "nombre",
        "type": "VARCHAR(200)",
        "key": "",
        "desc": "Nombre de la microempresa"
      },
      {
        "name": "umbral",
        "type": "NUMERIC(18,2)",
        "key": "",
        "desc": "Saldo mínimo definido por el propietario"
      }
    ],
    "unique": "",
    "checks": "umbral >= 0",
    "note": ""
  },
