  {
    "name": "cuenta",
    "purpose": "Registra la cuenta bancaria y la cobertura de su historial.",
    "fields": [
      {
        "name": "id",
        "type": "BIGINT",
        "key": "PK",
        "desc": "Identificador de cuenta"
      },
